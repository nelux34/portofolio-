        <section id="kontak" class="py-20 border-t border-zinc-200 dark:border-zinc-900 bg-white/50 dark:bg-charcoal/40">
            <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                    <div class="lg:col-span-5 space-y-6 reveal">
                        <span class="font-mono text-xs uppercase tracking-widest text-emerald-500 font-semibold">05 / Kontak</span>
                        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Mari Terhubung & Berdiskusi</h2>
                        <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed">
                            Tertarik berdiskusi mengenai pengembangan web, kolaborasi proyek informatika, atau eksplorasi kreatif? Jangan ragu untuk menghubungi saya.
                        </p>
                        
                        <div class="p-4 rounded-2xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 flex items-center justify-between gap-3">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center shrink-0">
                                    <i class="fa-regular fa-envelope"></i>
                                </div>
                                <div class="truncate">
                                    <div class="text-[11px] text-zinc-500 font-mono">Email Langsung</div>
                                    <div id="email-text" class="text-sm font-medium truncate">korneles.surune@email.com</div>
                                </div>
                            </div>
                            <button id="copy-email-btn" class="px-3.5 py-2 rounded-xl bg-zinc-100 dark:bg-zinc-800 hover:bg-emerald-500 hover:text-obsidian text-xs font-semibold transition-all shrink-0 flex items-center gap-1.5">
                                <i class="fa-regular fa-copy"></i>
                                <span id="copy-btn-label">Salin</span>
                            </button>
                        </div>

                        <div class="pt-2">
                            <div class="text-xs font-mono text-zinc-500 mb-3">Jejaring Profesional & Sosial</div>
                            <div class="flex flex-wrap gap-3">
                                <a href="https://github.com" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="w-11 h-11 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 hover:text-emerald-500 flex items-center justify-center transition-all">
                                    <i class="fa-brands fa-github text-lg"></i>
                                </a>
                                <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-11 h-11 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 hover:text-emerald-500 flex items-center justify-center transition-all">
                                    <i class="fa-brands fa-linkedin-in text-lg"></i>
                                </a>
                                <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-11 h-11 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 hover:text-emerald-500 flex items-center justify-center transition-all">
                                    <i class="fa-brands fa-instagram text-lg"></i>
                                </a>
                                <a href="mailto:korneles.surune@email.com" aria-label="Email" class="w-11 h-11 rounded-xl bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500 hover:text-emerald-500 flex items-center justify-center transition-all">
                                    <i class="fa-solid fa-envelope text-lg"></i>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="lg:col-span-7 reveal">
                        <form id="contact-form" novalidate class="p-6 sm:p-8 rounded-2xl bg-white dark:bg-charcoal border border-zinc-200 dark:border-zinc-800 space-y-5 shadow-xl shadow-black/5">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-zinc-600 dark:text-zinc-400 mb-2">Nama Lengkap</label>
                                    <input type="text" id="name" name="name" placeholder="Masukkan nama Anda" class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 focus:outline-none focus:border-emerald-500 text-sm transition-colors">
                                    <p id="error-name" class="hidden mt-1.5 text-xs text-rose-500">Nama wajib diisi minimal 2 karakter.</p>
                                </div>
                                <div>
                                    <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-zinc-600 dark:text-zinc-400 mb-2">Alamat Email</label>
                                    <input type="email" id="email" name="email" placeholder="nama@domain.com" class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 focus:outline-none focus:border-emerald-500 text-sm transition-colors">
                                    <p id="error-email" class="hidden mt-1.5 text-xs text-rose-500">Masukkan format email yang valid.</p>
                                </div>
                            </div>

                            <div>
                                <label for="subject" class="block text-xs font-semibold uppercase tracking-wider text-zinc-600 dark:text-zinc-400 mb-2">Subjek</label>
                                <input type="text" id="subject" name="subject" placeholder="Contoh: Kolaborasi Proyek Web" class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 focus:outline-none focus:border-emerald-500 text-sm transition-colors">
                            </div>

                            <div>
                                <label for="message" class="block text-xs font-semibold uppercase tracking-wider text-zinc-600 dark:text-zinc-400 mb-2">Pesan</label>
                                <textarea id="message" name="message" rows="4" placeholder="Tuliskan pesan atau detail proyek Anda..." class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 focus:outline-none focus:border-emerald-500 text-sm transition-colors"></textarea>
                                <p id="error-message" class="hidden mt-1.5 text-xs text-rose-500">Pesan wajib diisi minimal 10 karakter.</p>
                            </div>

                            <button type="submit" class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-obsidian font-semibold text-sm shadow-lg shadow-emerald-500/20 transition-all flex items-center justify-center gap-2">
                                <span>Kirim Pesan</span>
                                <i class="fa-solid fa-paper-plane text-xs"></i>
                            </button>

                            <div id="form-feedback" class="hidden p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-500 text-xs font-medium">
                                Pesan berhasil divalidasi dan siap dikirim! Terima kasih telah menghubungi.
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>

